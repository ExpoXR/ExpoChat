PUID=3000
ADMIN_USER=admin
# Prefer Argon2id. Keep the generated hash single-quoted so Compose preserves `$` characters.
# python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('YOUR_PASSWORD'))"
ADMIN_PASSWORD_HASH=''
# Legacy fallback only. Remove after ADMIN_PASSWORD_HASH is configured.
ADMIN_PASSWORD=replace-with-a-long-password
# Dev-only: set to true to allow the plaintext ADMIN_PASSWORD above when no hash
# is configured. Leave empty/false in production (the app requires the hash).
ALLOW_INSECURE_PASSWORD=
SESSION_SECRET=replace-with-a-long-random-secret
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
WORKER_TOKEN=replace-with-another-long-random-secret

# Default Ollama host seeded on first run. Point at your own server, e.g.
# http://ollama:11434 (same Docker network), http://127.0.0.1:11434 (same device),
# or http://<lan-ip>:11434 (another device on your network).
OLLAMA_BASE_URL=http://ollama:11434
# Comma-separated workspace roots the app may read/stage. Adjust to your host paths.
ALLOWED_ROOTS=/workspace/apps,/workspace/projects
COMMAND_TIMEOUT=120
SNAPSHOT_RETENTION_DAYS=30
SNAPSHOT_MAX_BYTES=21474836480
SNAPSHOT_RESERVE_BYTES=2147483648
ORPHAN_GRACE_HOURS=24
RUNNER_CONCURRENCY=1
WORKER_POOL_SIZE=1
CHAT_CONTEXT_BYTES=120000

# Optional environment providers. UI-linked keys are encrypted in SQLite.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

ALLOWED_ORIGINS=
SECURE_COOKIE=false
FORWARDED_ALLOW_IPS=127.0.0.1
